# Public canonical site URL used in metadata, sitemap, robots, and structured data.
NEXT_PUBLIC_SITE_URL=https://nh-enterprises-catalog.vercel.app

# Google Search Console verification token (leave empty until verified).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only Telegram bot token; never use a NEXT_PUBLIC_ prefix.
TELEGRAM_BOT_TOKEN=

# Server-only comma-separated Telegram chat IDs; never use a NEXT_PUBLIC_ prefix.
TELEGRAM_CHAT_ID=
